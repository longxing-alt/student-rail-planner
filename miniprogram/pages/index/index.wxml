<!-- 学生票区间规划器 · 主页面（按原型简化版重构） -->
<view class="page">

  <!-- 品牌头（长按开关调试编号） -->
  <view class="brand-bar" bindlongpress="toggleDbg">
    <view class="brand-logo">优</view>
    <view class="brand-name">学生优惠 · 区间规划器</view>
  </view>

  <!-- 状态条 -->
  <view class="status" wx:if="{{status}}">{{status}}</view>

  <view class="workspace">
    <!-- ============ 步骤1: 学校 ============ -->
    <view class="card step1">
      <view class="label">① 学校 <text class="sub">区间固定端点（须与学信网一致）</text></view>
      <view class="row">
        <input class="ipt" value="{{schoolInput}}" bindinput="onSchoolInput" bindconfirm="nextSchool" placeholder="输入学校城市，如：北京"/>
        <button hover-class="bh" class="btn primary" bindtap="nextSchool">下一步</button>
      </view>
    </view>

    <!-- ============ 步骤2: 出发地 ============ -->
    <view class="card step2 {{showDepart?'show':''}}">
      <view class="label">② 出发地 <text class="sub">区间端点 + 行程起点</text></view>
      <view class="row">
        <input class="ipt" value="{{departInput}}" bindinput="onDepartInput" bindconfirm="nextDepart" placeholder="输入出发城市，如：石家庄"/>
        <button hover-class="bh" class="btn primary" bindtap="nextDepart">下一步</button>
      </view>
      <view class="hint">优惠区间 = 学校 ↔ 出发地（颜色判定用它）。优化建议会告诉你"把区间改为 学校↔X"，请按它在铁路学生优惠资质中自行修改真实家庭地址。</view>
    </view>

    <!-- ============ 步骤3: 目的地 + 规划 ============ -->
    <view class="step3 {{showDest?'show':''}}">
      <!-- 想去哪卡片: 输入在前, 与样例一致 -->
      <view class="card">
        <view class="label">③ 想去哪 <text class="sub">点【一键规划】后判定：绿=区间内 · 橙=可能被查 · 红=超区间</text></view>
        <view class="row">
          <input class="ipt" value="{{tripInput}}" bindinput="onTripInput" bindconfirm="addTrip" placeholder="添加想去的地方，如：长沙"/>
          <button hover-class="bh" class="btn primary" bindtap="addTrip">添加</button>
        </view>
        <view class="hint">每个框可 ✕ 删除 · 按住 ≡ 拖动排序 · 改动后请重新【一键规划】</view>
      </view>
      <!-- 常驻区间线: 学校—区间端点, 规划后圆点着色 -->
      <view class="iv-line top">
        <text class="iv-node s">{{ivS}}</text>
        <view class="iv-track">
          <view class="iv-zone"></view>
          <view class="iv-pt {{item.cls}}" wx:for="{{ivDots}}" wx:key="name" style="left:{{item.left}}%"></view>
        </view>
        <text class="iv-node h">{{ivH}}</text>
      </view>

      <!-- 目的地列表: 起点行固定 + 着色框 + 拖动 + 删除 -->
      <view class="dest-list">
        <view class="dest start">
          <text class="handle">≡</text>
          <view class="ring start"><text class="dot">起</text></view>
          <text class="name">{{startName}}</text>
          <text class="status">起点 · 出发地</text>
        </view>
        <view class="empty-hint" wx:if="{{!rows.length}}">还没有目的地，在上方输入添加 👆</view>
        <view class="dest {{item.boxCls}} {{tdIndex===index?'dragging':''}} {{item.anim?'in':''}}" wx:for="{{rows}}" wx:key="key" bindtap="tfmTap" data-i="{{index}}">
          <text class="handle" data-i="{{index}}" catchtouchstart="tdStart" catchtouchmove="tdMove" catchtouchend="tdEnd">≡</text>
          <view class="ring {{item.ring}}" wx:if="{{item.ring}}"></view>
          <text class="name">{{item.text}}</text>
          <text class="status" wx:if="{{item.status}}">{{item.status}}</text>
          <view wx:if="{{item.hubs.length}}" class="hub-line">
            <text class="hub-tag">{{item.hubPrefix}}</text>
            <text wx:for="{{item.hubs}}" wx:key="n" wx:for-item="hb" class="hub-chip {{hb.cur?'on':''}}" data-i="{{item.iIdx}}" data-j="{{hb.idx}}" catchtap="setHubTap">{{hb.m}}{{hb.n}}</text>
          </view>
          <text class="x" data-id="{{item.id}}" catchtap="removeTrip">✕</text>
        </view>
      </view>

      <!-- 结果: 消耗次数 -->
      <view class="result {{planned?'show':''}}">
        <view class="used"><text class="num {{used>budget?'red':''}}">{{used}}</text><text class="unit">次 / 预算 {{budget}} · 剩余 <text class="remain {{remain<0?'red':''}}">{{remain}}</text> 次</text></view>
        <view class="meta">
          <view class="chip green" wx:if="{{okN>0}}">区间内 {{okN}}/{{tripCount}}</view>
          <view class="chip orange" wx:if="{{edgeN>0}}">可能被查 {{edgeN}}</view>
          <view class="chip red" wx:if="{{badN>0}}">超区间 {{badN}}（另购全价）</view>
          <view class="chip green" wx:if="{{okN+edgeN>0}}">整条联程 {{used}} 次（5 天内）</view>
          <view class="chip gray" wx:if="{{okN+edgeN==0}}">全部需全价</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 规划区: 清空 + 一键规划 -->
  <view class="plan-bar {{showDest?'show':''}}">
    <button hover-class="bh" class="btn ghost plan-clear" wx:if="{{tripCount>0}}" bindtap="clearAll">🗑 清空全部目的地</button>
    <button hover-class="bh" class="btn primary plan-btn" wx:if="{{showDest}}" bindtap="onPlan">🚀 一键规划行程</button>
  </view>

  <!-- 区间建议弹窗 -->
  <view class="mask" wx:if="{{modal.show}}" bindtap="closeModal">
    <view class="dialog" catchtap="noop">
      <view class="dialog-title">🎯 区间优化建议<text class="dialog-close" catchtap="closeModal">✕</text></view>
      <view class="dialog-body">
        <block wx:if="{{modal.suggest}}">
          <view class="m-line">当前区间（{{ivS}} ↔ {{ivH}}）太小，多数目的地超出区间（红）。</view>
          <view class="m-line">推荐把区间改为：<b>{{ivS}}</b> ↔ <text class="m-best">{{modal.suggest.name}} · {{modal.suggest.city}}</text><br/>（原出发地 <b>{{startName}}</b> 保持不变）</view>
          <view class="m-line warn" wx:if="{{modal.isDest}}">⚠️ 推荐点=你的目的地，非家址会绕路；就近替代：<b>{{modal.altern}}</b></view>
          <view class="m-line">→ {{tripCount}} 个目的地：<text class="g2">{{modal.g2}} 绿</text> / <text class="e2">{{modal.e2}} 橙</text> / <text class="b2">{{modal.b2}} 红</text></view>
          <view class="m-line dests" wx:if="{{modal.dests.length}}">
            <view class="m-dest-line" wx:for="{{modal.dests}}" wx:key="text"><text class="m-dot {{item.cls}}"></text>{{item.text}} = <text class="{{item.cls}}">{{item.c}}</text></view>
          </view>
          <view class="m-note">采用后按新区间判定，出发地（{{startName}}）不变；实际修改请在核验中把家改为 {{modal.suggest.city}}。</view>
        </block>
        <block wx:else>
          <view class="m-line">当前区间已是最优：<b>{{ivS}}</b> ↔ <b>{{ivH}}</b> → 区间内 {{okN}}/{{tripCount}} 站。</view>
        </block>
      </view>
      <view class="dialog-btns">
        <button hover-class="bh" class="btn ghost sm" wx:if="{{modal.suggest}}" catchtap="applySuggestion">采用推荐区间</button>
        <view class="gspacer"></view>
        <button hover-class="bh" class="btn primary sm" catchtap="closeModal">知道了</button>
      </view>
    </view>
  </view>

  <view class="footer">
    免责声明：判定结果基于实测数据推算，仅供参考，实际以 12306 出票为准；不构成购票或区间修改建议。
  </view>

  <!-- 中转购买说明(分步向导, 仿网页) -->
  <view class="mask" wx:if="{{tfm.show}}" bindtap="closeTfm">
    <view class="dialog" catchtap="noop">
      <view class="dialog-title">⇄ 中转购买说明<text class="dialog-close" catchtap="closeTfm">✕</text></view>
      <view class="dialog-body" wx:if="{{tfm.step===1}}">
        <view class="m-line"><b>区间不用改</b>：保持<b>优惠区间为 {{tfm.S}} ⇄ {{tfm.H}}</b> 不变，只做中转。</view>
      </view>
      <view class="dialog-body" wx:if="{{tfm.step===2}}">
        <view class="m-line">选择在 12306 上<b>可以中转的地点</b>（①推荐 ②次选…，点选后以下步骤以它为例）：</view>
        <view class="m-line" style="flex-wrap:wrap;gap:6px" wx:for="{{tfm.cands}}" wx:key="name">
          <text class="hub-chip {{item.name===tfm.hub?'on':''}}" data-j="{{index}}" catchtap="tfmPick">{{index===0?'①':index===1?'②':index===2?'③':index===3?'④':index===4?'⑤':index===5?'⑥':index===6?'⑦':'⑧'}}{{item.name}}</text>
        </view>
      </view>
      <view class="dialog-body" wx:if="{{tfm.step===3}}">
        <view class="m-line">在 12306 购票时选「<b>中转</b>」，中转站填 <b>{{tfm.hub}}</b>。</view>
        <view class="m-line">首段 <b>{{tfm.a}} → {{tfm.hub}}</b> 按学生票购买（两端都在区间内）。</view>
      </view>
      <view class="dialog-body" wx:if="{{tfm.step===4}}">
        <view class="m-line">后续段 <b>{{tfm.hub}} → {{tfm.b}}</b> 随联程放行，全程计 1 次优惠。</view>
        <view class="m-note">实际以 12306 出票为准；若该中转站没有合适后续车，回到上一步换一个站。</view>
      </view>
      <view class="dialog-btns">
        <button hover-class="bh" class="btn ghost sm" wx:if="{{tfm.step>1}}" catchtap="tfmPrev">← 上一步</button>
        <button hover-class="bh" class="btn primary sm" wx:if="{{tfm.step<4}}" catchtap="tfmNext">下一步</button>
        <button hover-class="bh" class="btn primary sm" wx:if="{{tfm.step===4}}" catchtap="closeTfm">知道了</button>
      </view>
    </view>
  </view>

  <!-- 调试编号层（长按品牌头开关） -->
  <view class="dbg-overlay" wx:if="{{dbg.on}}">
    <view class="dbg-badge" wx:for="{{dbg.badges}}" wx:key="n" style="left:{{item.x}}px;top:{{item.y}}px">{{item.n}}</view>
    <view class="dbg-pill" bindtap="toggleDbgLegend">{{dbg.showLegend?'✕ 收起对照':'🔢 编号对照'}}</view>
    <view class="dbg-legend" wx:if="{{dbg.showLegend}}">
      <view class="dbg-legend-title">元素编号对照 <text class="dbg-hint">（长按顶部品牌头关闭）</text></view>
      <view class="dbg-item" wx:for="{{dbg.list}}" wx:key="n">{{item.n}} = {{item.name}}</view>
      <button hover-class="bh" class="btn primary sm" bindtap="toggleDbg">关闭编号</button>
    </view>
  </view>
</view>
