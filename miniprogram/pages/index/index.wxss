/* 学生票区间规划器 · 样式（卡片式 + 靛蓝主色） */
page { background: #F0F2F5; }
.page {
  max-width: 480px; margin: 0 auto; min-height: 100vh; box-sizing: border-box;
  background: #F7F8FA; padding: 24rpx 28rpx 200rpx;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  color: #111827; font-size: 28rpx; line-height: 1.6;
  -webkit-tap-highlight-color: transparent;
}
.bh { opacity: .82; }

/* 状态条 */
.status {
  display: flex; align-items: center; gap: 10rpx;
  background: #EFF6FF; color: #2563EB; border-radius: 16rpx;
  padding: 14rpx 20rpx; font-size: 24rpx; margin-bottom: 20rpx; line-height: 1.5;
}
.status.done { background: #ECFDF5; color: #059669; }
.status-ico {
  flex: none; width: 30rpx; height: 30rpx; border-radius: 99rpx; font-size: 20rpx; font-weight: 800;
  display: flex; align-items: center; justify-content: center; background: rgba(37,99,235,.14);
}
.status.done .status-ico { background: rgba(5,150,105,.16); }
.status-txt { flex: 1; }

/* 卡片 */
.card {
  background: #fff; border-radius: 32rpx; padding: 36rpx 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(16,24,40,.04); margin-bottom: 24rpx;
}
#cardDepart { display: none; }
#cardDepart.show { display: block; animation: fadeInUp .4s ease-out both; }
@keyframes fadeInUp { from { opacity: 0; transform: translateY(16rpx); } to { opacity: 1; transform: translateY(0); } }

.card-head { display: flex; align-items: center; margin-bottom: 24rpx; }
.step-no {
  flex: none; width: 44rpx; height: 44rpx; border-radius: 99rpx; background: #DBEAFE; color: #2563EB;
  font-size: 26rpx; font-weight: 800; display: flex; align-items: center; justify-content: center; margin-right: 14rpx;
}
.card-tt { font-size: 32rpx; font-weight: 600; color: #111827; }
.card-tip { margin-left: auto; font-size: 22rpx; color: #9CA3AF; }

/* 输入 */
.ipt {
  width: 100%; box-sizing: border-box; background: #F9FAFB; border: 1rpx solid #E5E7EB;
  border-radius: 22rpx; padding: 24rpx 28rpx; font-size: 28rpx; color: #111827; min-height: 44rpx;
}
.ipt.grow { flex: 1; }
.add-row { display: flex; gap: 16rpx; margin-bottom: 12rpx; }
.field-hint { font-size: 22rpx; color: #9CA3AF; margin: 14rpx 0 4rpx; line-height: 1.6; }
.field-hint .hl { color: #2563EB; font-weight: 600; }

/* 按钮 */
.btn {
  border: none; border-radius: 22rpx; font-size: 28rpx; font-weight: 600;
  padding: 24rpx 0; width: 100%; margin-top: 22rpx; line-height: 1.2;
}
.btn::after { border: none; }
.btn.primary { background: #2563EB; color: #fff; }
.btn.dark { background: #111827; color: #fff; }
.btn.ghost { background: #fff; color: #374151; border: 1rpx solid #E5E7EB; }
.btn.sm { width: auto; padding: 16rpx 32rpx; font-size: 26rpx; margin-top: 0; }
.btn[disabled] { opacity: .5; }

/* 只读行 */
.ro-row {
  display: flex; align-items: center; justify-content: space-between;
  background: #F9FAFB; border: 1rpx solid #F3F4F6; border-radius: 22rpx; padding: 24rpx 28rpx;
}
.ro-name { font-size: 28rpx; font-weight: 600; color: #111827; }
.ro-tag { font-size: 22rpx; color: #6B7280; background: #F3F4F6; border-radius: 10rpx; padding: 6rpx 14rpx; }
.sub-row { display: flex; align-items: center; justify-content: space-between; margin-top: 18rpx; font-size: 22rpx; }
.sub-txt { color: #6B7280; }
.link { color: #2563EB; font-weight: 600; }

/* 区间线 */
.iv-line { padding: 36rpx 8rpx 20rpx; border-bottom: 1rpx solid #F3F4F6; margin-bottom: 20rpx; }
.iv-track { position: relative; height: 8rpx; background: #E5E7EB; border-radius: 99rpx; margin: 0 16rpx; }
.iv-zone { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background: #DBEAFE; border-radius: 99rpx; }
.iv-pt {
  position: absolute; top: 50%; width: 20rpx; height: 20rpx; border-radius: 99rpx;
  transform: translate(-50%, -50%); border: 3rpx solid #fff; box-shadow: 0 0 0 3rpx #E5E7EB;
}
.iv-pt.ok { background: #22C55E; box-shadow: 0 0 0 3rpx #DCFCE7; }
.iv-pt.edge { background: #F97316; box-shadow: 0 0 0 3rpx #FFEDD5; }
.iv-pt.bad { background: #EF4444; box-shadow: 0 0 0 3rpx #FEE2E2; }
.iv-nodes { display: flex; justify-content: space-between; margin-top: 16rpx; }
.iv-node { font-size: 22rpx; color: #4B5563; font-weight: 600; }

/* 目的地列表 */
.dest-list { margin-top: 4rpx; }
.empty-hint { font-size: 24rpx; color: #9CA3AF; text-align: center; padding: 36rpx 0; }
.dest {
  display: flex; align-items: center; gap: 16rpx; padding: 22rpx 24rpx; border-radius: 20rpx;
  border: 1rpx solid #F3F4F6; background: #fff; margin-bottom: 14rpx; position: relative;
}
.dest.start { background: #FAFAFA; }
.dest.ok { background: #F0FDF4; border-color: #BBF7D0; }
.dest.edge { background: #FFF7ED; border-color: #FED7AA; }
.dest.bad { background: #FEF2F2; border-color: #FECACA; }
.dest.dragging { opacity: .6; }
.handle { flex: none; color: #D1D5DB; font-size: 26rpx; width: 32rpx; text-align: center; }
.dest.ok .handle { color: #22C55E; }
.dest.edge .handle { color: #F97316; }
.dest.bad .handle { color: #EF4444; }
.ring { flex: none; width: 18rpx; height: 18rpx; border-radius: 99rpx; background: #E5E7EB; }
.ring.none { opacity: 0; }
.ring.ok { background: #22C55E; }
.ring.edge { background: #F97316; }
.ring.bad { background: #EF4444; }
.ring.start {
  width: 32rpx; height: 32rpx; background: #9CA3AF; color: #fff; font-size: 18rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
}
.name { font-size: 28rpx; font-weight: 600; color: #111827; flex: none; }
.tkt { font-size: 22rpx; color: #6B7280; }
.status { font-size: 22rpx; color: #6B7280; margin-left: auto; }
.dest.ok .status { color: #15803D; }
.dest.edge .status { color: #C2410C; }
.dest.bad .status { color: #B91C1C; }
.x { position: absolute; right: 12rpx; top: 50%; transform: translateY(-50%); color: #D1D5DB; font-size: 24rpx; padding: 12rpx; }

/* 中转候选 */
.hub-line { margin-top: 10rpx; }
.hub-tag { font-size: 22rpx; color: #9CA3AF; }
.hub-grid { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 8rpx; }
.hub-chip {
  font-size: 22rpx; color: #C2410C; background: #FFF7ED; border: 1rpx solid #FED7AA;
  border-radius: 99rpx; padding: 6rpx 18rpx;
}
.hub-chip.on { background: #F97316; color: #fff; border-color: #EA580C; font-weight: 700; }

/* 结果卡片：次数 + 右侧分享圆形按钮 */
.result { display: none; margin-top: 24rpx; }
.result.show { display: block; animation: fadeInUp .4s ease-out both; }
.result-card {
  background: linear-gradient(135deg, #EFF6FF 0%, #DBEAFE 100%);
  border: 1rpx solid #BFDBFE; border-radius: 32rpx; padding: 32rpx;
  display: flex; align-items: flex-end; justify-content: space-between; gap: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(37,99,235,.06);
}
.rc-main { flex: 1; min-width: 0; }
.rc-label { font-size: 22rpx; color: #2563EB; font-weight: 600; display: flex; align-items: center; gap: 10rpx; margin-bottom: 8rpx; }
.rc-q {
  width: 30rpx; height: 30rpx; border-radius: 99rpx; border: 1rpx solid #93C5FD; color: #60A5FA;
  font-size: 20rpx; display: flex; align-items: center; justify-content: center;
}
.rc-num { display: flex; align-items: baseline; gap: 8rpx; }
.rc-num .num { font-size: 52rpx; font-weight: 800; color: #111827; font-family: ui-monospace, Menlo, monospace; }
.rc-num .num.red { color: #DC2626; }
.rc-num .unit { font-size: 26rpx; color: #4B5563; }
.rc-num .sep { color: #D1D5DB; margin: 0 6rpx; }
.rc-num .rest { font-size: 24rpx; color: #6B7280; }
.rc-chips { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 16rpx; }
.chip {
  font-size: 20rpx; border-radius: 8rpx; padding: 4rpx 12rpx; background: #fff; border: 1rpx solid #E5E7EB; color: #6B7280;
}
.chip.green { color: #2563EB; border-color: #BFDBFE; }
.chip.orange { color: #C2410C; border-color: #FED7AA; background: #FFF7ED; }
.chip.red { color: #B91C1C; border-color: #FECACA; background: #FEF2F2; }
.chip.gray { color: #6B7280; }

.rc-actions { display: flex; gap: 16rpx; flex: none; }
.circle-btn {
  width: 84rpx; height: 84rpx; border-radius: 99rpx; padding: 0; margin: 0;
  display: flex; align-items: center; justify-content: center;
  background: #fff; border: 1rpx solid #BFDBFE; color: #2563EB; box-shadow: 0 2rpx 8rpx rgba(16,24,40,.06);
}
.circle-btn::after { border: none; }
.circle-btn.primary { background: #2563EB; color: #fff; border-color: #1D4ED8; }
.cb-ico { font-size: 34rpx; line-height: 1; }

/* 底部操作栏 */
.plan-bar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 30;
  max-width: 480px; margin: 0 auto; box-sizing: border-box;
  background: #fff; border-top: 1rpx solid #F3F4F6; padding: 22rpx 28rpx 32rpx;
  display: none; gap: 16rpx; box-shadow: 0 -4rpx 20rpx rgba(16,24,40,.04);
}
.plan-bar.show { display: flex; }
.icon-btn {
  flex: none; width: 92rpx; height: 92rpx; padding: 0; margin: 0; border-radius: 22rpx;
  background: #F3F4F6; color: #6B7280; font-size: 34rpx;
  display: flex; align-items: center; justify-content: center;
}
.icon-btn::after { border: none; }
.plan-btn { flex: 1; margin-top: 0; padding: 26rpx 0; }

/* 页脚 */
.footer {
  margin: 40rpx 0 0; padding: 24rpx 8rpx; font-size: 20rpx; color: #9CA3AF;
  text-align: center; line-height: 1.7; border-top: 1rpx solid #F1F0EF;
}

/* 弹窗 */
.mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: 1100;
  background: rgba(0,0,0,.5); display: flex; align-items: center; justify-content: center; padding: 40rpx;
}
.dialog {
  width: 100%; max-width: 620rpx; background: #fff; border-radius: 32rpx; padding: 40rpx 36rpx;
  box-shadow: 0 24rpx 70rpx rgba(0,0,0,.28); animation: fadeInUp .3s ease-out both;
}
.dialog-title { font-size: 32rpx; font-weight: 800; color: #111827; margin-bottom: 22rpx; position: relative; }
.dialog-close { position: absolute; right: 0; top: -6rpx; font-size: 30rpx; color: #9CA3AF; padding: 8rpx 12rpx; }
.m-line { font-size: 27rpx; line-height: 1.85; color: #4B5563; }
.m-line b { color: #111827; }
.m-line .red { color: #EF4444; font-weight: 600; }
.m-line.warn { color: #C2410C; background: #FFF7ED; border: 1rpx solid #FED7AA; border-radius: 14rpx; padding: 14rpx 18rpx; margin-top: 12rpx; }
.m-best { color: #2563EB; font-weight: 800; background: #EFF6FF; border-radius: 8rpx; padding: 2rpx 10rpx; }
.g2 { color: #15803D; font-weight: 700; }
.e2 { color: #C2410C; font-weight: 700; }
.b2 { color: #B91C1C; font-weight: 700; }
.m-note { font-size: 22rpx; color: #9CA3AF; line-height: 1.7; margin-top: 16rpx; }
.preview-box { background: #F9FAFB; border: 1rpx solid #F3F4F6; border-radius: 18rpx; padding: 18rpx; margin-top: 16rpx; }
.pv-title { font-size: 24rpx; font-weight: 600; color: #374151; margin-bottom: 10rpx; }
.pv-list { display: flex; flex-wrap: wrap; gap: 10rpx; }
.pv-chip { font-size: 22rpx; border-radius: 8rpx; padding: 4rpx 12rpx; background: #F3F4F6; color: #4B5563; }
.pv-chip.ok { background: #F0FDF4; color: #15803D; }
.pv-chip.edge { background: #FFF7ED; color: #C2410C; }
.pv-chip.bad { background: #FEF2F2; color: #B91C1C; }
.dialog-btns { display: flex; align-items: center; gap: 16rpx; margin-top: 32rpx; }
.gspacer { flex: 1; }

/* 海报弹窗 */
.poster-dialog { max-width: 640rpx; }
.poster-wrap { display: flex; align-items: center; justify-content: center; min-height: 320rpx; }
.poster-img { width: 100%; border-radius: 20rpx; }
.poster-loading { font-size: 26rpx; color: #9CA3AF; padding: 80rpx 0; }
.poster-canvas { position: fixed; left: -9999px; top: 0; width: 600px; height: 900px; }

/* 调试编号层 */
.dbg-overlay { position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: 1200; pointer-events: none; }
.dbg-badge {
  position: absolute; background: #EF4444; color: #fff; font-size: 20rpx; font-weight: 700;
  border-radius: 99rpx; padding: 2rpx 10rpx; transform: translate(-50%, -50%);
}
.dbg-pill {
  position: fixed; right: 24rpx; bottom: 240rpx; pointer-events: auto;
  background: #111827; color: #fff; font-size: 22rpx; border-radius: 99rpx; padding: 12rpx 22rpx;
}
.dbg-legend {
  position: fixed; left: 40rpx; right: 40rpx; bottom: 320rpx; pointer-events: auto;
  background: #fff; border-radius: 24rpx; padding: 24rpx; box-shadow: 0 12rpx 40rpx rgba(0,0,0,.2);
}
.dbg-legend-title { font-size: 26rpx; font-weight: 700; margin-bottom: 12rpx; }
.dbg-item { font-size: 24rpx; color: #4B5563; line-height: 1.8; }
